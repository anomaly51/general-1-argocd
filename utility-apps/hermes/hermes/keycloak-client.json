{
  "clientId": "hermes-web",
  "name": "Hermes",
  "description": "Owner-only Hermes browser access; no Keycloak admin permissions.",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": true,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "fullScopeAllowed": false,
  "rootUrl": "https://hermes.api-api-api.com",
  "baseUrl": "/",
  "redirectUris": [
    "https://hermes.api-api-api.com/auth/callback"
  ],
  "webOrigins": [
    "https://hermes.api-api-api.com"
  ],
  "defaultClientScopes": [
    "profile",
    "email"
  ],
  "optionalClientScopes": [],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "https://hermes.api-api-api.com/"
  }
}
