{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "authGlobalNamespace": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "authName",
          "serviceAccountName",
          "role",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "authName": {
            "type": "string",
            "minLength": 1
          },
          "serviceAccountName": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "mount": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "kv-v1",
              "kv-v2"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+$"
          },
          "refreshAfter": {
            "type": "string",
            "minLength": 1
          },
          "syncWaves": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "serviceAccount": {
                "type": "string"
              },
              "vaultAuth": {
                "type": "string"
              },
              "vaultStaticSecret": {
                "type": "string"
              }
            }
          },
          "rolloutRestartTargets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "name"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "Deployment",
                    "StatefulSet",
                    "DaemonSet",
                    "Rollout"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "global": {
      "type": "object"
    }
  },
  "required": [
    "enabled",
    "authGlobalNamespace",
    "bindings"
  ],
  "if": {
    "properties": {
      "enabled": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "bindings": {
        "minItems": 1
      }
    }
  }
}
