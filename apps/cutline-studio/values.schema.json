{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "images",
    "replicas",
    "migration",
    "routes"
  ],
  "properties": {
    "replicas": {
      "type": "object",
      "properties": {
        "api": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "frontend": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "migration": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "maxActiveJobs": {
          "type": "integer",
          "minimum": 1
        },
        "recoverGenerationJobs": {
          "type": "boolean"
        },
        "purgeLegacyData": {
          "type": "boolean"
        },
        "telegramBotEnabled": {
          "type": "boolean"
        },
        "telegramDailyMemesEnabled": {
          "type": "boolean"
        }
      }
    },
    "routes": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
