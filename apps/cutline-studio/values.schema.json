{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["images", "replicas", "migration", "auth"],
  "properties": {
    "replicas": {
      "type": "object",
      "properties": {
        "api": {"type": "integer", "minimum": 0, "maximum": 1},
        "frontend": {"type": "integer", "minimum": 1},
        "oauth2Proxy": {"type": "integer", "minimum": 1}
      }
    },
    "migration": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "auth": {
      "type": "object",
      "required": ["allowedGroup"],
      "properties": {
        "allowedGroup": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"}
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "maxActiveJobs": {"type": "integer", "minimum": 1},
        "recoverGenerationJobs": {"type": "boolean"},
        "purgeLegacyData": {"type": "boolean"},
        "telegramBotEnabled": {"type": "boolean"},
        "telegramDailyMemesEnabled": {"type": "boolean"}
      }
    }
  }
}
